# Скопируй в .env.docker и заполни. Спецсимволы в пароле URL-кодируй:
#   @ → %40, ? → %3F, + → %2B, / → %2F, # → %23

# Postgres-контейнер на том же NAS публикует порт на хост (в текущей базе — 5433).
# Из контейнера приложения хост достаётся через host.docker.internal (extra_hosts).
DATABASE_URL=postgres://tasktracker:ПАРОЛЬ_URLENCODED@host.docker.internal:5433/tasktracker
# Альтернатива: подключить оба контейнера в общую docker-сеть и указать имя сервиса PG,
#   напр. postgres://tasktracker:...@postgres:5432/tasktracker

# Better Auth — обязательно. Сгенерируй: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL, по которому открываешь приложение. Должен совпадать с redirect URI в Google OAuth.
BETTER_AUTH_URL=http://NAS_IP:3000

# Google OAuth (опционально). В Google Cloud Console добавь redirect URI:
#   http://NAS_IP:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
