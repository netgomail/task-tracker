# Скопируй в .env.docker и заполни. Спецсимволы в пароле URL-кодируй:
#   @ → %40, ? → %3F, + → %2B, / → %2F, # → %23

# Пароль Postgres. Используется и контейнером postgres (POSTGRES_PASSWORD), и в
# DATABASE_URL ниже. В POSTGRES_PASSWORD — как есть, в DATABASE_URL — URL-кодированный.
POSTGRES_PASSWORD=ПАРОЛЬ_КАК_ЕСТЬ

# Приложение работает в host-сети и достаёт Postgres по опубликованному порту 5433
# через loopback самого NAS. Пароль здесь — URL-кодированный.
DATABASE_URL=postgres://tasktracker:ПАРОЛЬ_URLENCODED@127.0.0.1:5433/tasktracker

# Better Auth — обязательно. Сгенерируй: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL, по которому открываешь приложение. Должен совпадать с redirect URI в Google OAuth.
BETTER_AUTH_URL=http://NAS_IP:3000

# Google OAuth (опционально). В Google Cloud Console добавь redirect URI:
#   http://NAS_IP:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Имя Obsidian-vault для ссылок «Открыть заметку» с карточек (опционально,
# вшивается при сборке). Без него Obsidian откроет последнее активное хранилище.
# NEXT_PUBLIC_OBSIDIAN_VAULT=ОРД
