# Скопируй в .env.docker и заполни, затем: docker compose up -d
# Спецсимволы в пароле для DATABASE_URL URL-кодируй: @→%40, ?→%3F, +→%2B, /→%2F, #→%23
# (проще всего выбрать пароль без спецсимволов — тогда кодировать не придётся)

# Пароль Postgres как есть — читает контейнер БД.
POSTGRES_PASSWORD=d13aedb3fd3aa49642041d8a4e429ee0

# Тот же пароль (URL-кодированный) в строке подключения. Хост "postgres" —
# имя сервиса в docker-compose, Docker сам резолвит его во внутренней сети
# контейнеров — редактировать не нужно, только пароль.
DATABASE_URL=postgres://tasktracker:d13aedb3fd3aa49642041d8a4e429ee0@postgres:5432/tasktracker

# Better Auth — обязательно. Сгенерируй: openssl rand -base64 32
BETTER_AUTH_SECRET=MvtKhJwvZPbDespHaVgmecHMRfE5FJWgXwQdzPoV2wE=

# URL, по которому открываешь приложение. Локально — localhost; если
# разворачиваешь на другой машине в сети — её IP или домен.
BETTER_AUTH_URL=http://localhost:3000

# Имя Obsidian-vault для ссылок «Открыть заметку» с карточек (опционально,
# вшивается при сборке). Без него Obsidian откроет последнее активное хранилище.
# NEXT_PUBLIC_OBSIDIAN_VAULT=ОРД

# Безопасность (значения 1/true включают):
# Отключить самостоятельную регистрацию (/register и API sign-up).
# DISABLE_REGISTRATION=1
# Доверять X-Forwarded-For — ТОЛЬКО если перед приложением reverse-proxy,
# который перезаписывает этот заголовок.
# TRUSTED_PROXY=1