# Postgres (на Synology через WireGuard). Спецсимволы в пароле URL-кодируй:
#   @ → %40, ? → %3F, + → %2B, / → %2F, # → %23
DATABASE_URL=postgres://tasktracker:ПАРОЛЬ@IP_NAS:5433/tasktracker

# Better Auth — required, generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Имя Obsidian-vault для ссылок «Открыть заметку» с карточек (опционально,
# вшивается при сборке). Без него Obsidian откроет последнее активное хранилище.
# NEXT_PUBLIC_OBSIDIAN_VAULT=ОРД

# Безопасность (значения 1/true включают):
# Отключить самостоятельную регистрацию (/register и API sign-up).
# DISABLE_REGISTRATION=1
# Доверять X-Forwarded-For — ТОЛЬКО если перед приложением reverse-proxy,
# который перезаписывает этот заголовок.
# TRUSTED_PROXY=1
